# --- Veritabanı (Neon Postgres) ---------------------------------------------
# Tanımlıysa iletişim başvuruları, site içeriği ve siparişler Postgres'e yazılır.
# Tanımlı değilse yerel data/*.json dosyalarına düşer (yalnızca geliştirme).
# DATABASE_URL="postgres://kullanici:sifre@host/db?sslmode=require"

# --- Admin paneli (/void-admin) ---------------------------------------------
# Yönetici giriş şifresi. Tanımlı değilse koddaki varsayılan kullanılır.
# ADMIN_PASSWORD="Berkdrkl123*"
# Oturum çerezini imzalayan gizli anahtar. ÜRETİMDE mutlaka güçlü bir değerle
# doldurun (ör. `openssl rand -base64 32`).
# ADMIN_SECRET="uzun-rastgele-bir-anahtar"

# --- Ödeme (iyzico) — daha sonra bağlanacak ---------------------------------
# IYZICO_API_KEY="sandbox-xxxxxxxx"
# IYZICO_SECRET_KEY="sandbox-xxxxxxxx"
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
